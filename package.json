{
  "name": "deep-shield-electron",
  "version": "1.0.0",
  "description": "Deep Shield - Deepfake Detection Desktop Application",
  "main": "electron/main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "electron:dev": "electron .",
    "electron:start": "electron .",
    "electron:build": "electron-builder",
    "backend:dev": "cd backend && npm run dev",
    "frontend:dev": "cd frontend && pnpm dev"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.deepshield.app",
    "productName": "Deep Shield",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "backend/**/*",
      "frontend/.next/**/*",
      "frontend/public/**/*",
      "frontend/package.json",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}

